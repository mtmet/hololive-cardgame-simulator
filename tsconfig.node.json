{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "server",
    "src/game/online/protocol.ts",
    "src/game/actions.ts",
    "src/game/decks/rules.ts",
    "src/game/decks/sampleSource.ts",
    "src/game/matches/rulesVersion.ts",
    "src/game/engine.ts",
    "src/game/types.ts",
    "src/game/effects.ts",
    "src/game/view.ts",
    "src/game/ai",
    "src/data/types.ts",
    "src/data/loader.ts",
    "src/data/cardSource.ts",
    "data/*.json",
    "src/game/effects",
    "src/game/engine"
  ]
}
